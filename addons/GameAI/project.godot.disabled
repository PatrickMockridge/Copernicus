; Engine configuration file.
config_version=5

[application]
config/name="GameAI SDK"
config/description="AI integration for Godot 4 - Connect to Claude, OpenAI, Minimax, and more"
run/main_scene="res://demo.tscn"
config/features=PackedStringArray("4.2", "GL Compliance")
config/icon="res://icon.svg"

[autoload]
GameAI="*res://addons/gameai/core/ai.gd"

[editor_plugins]
enabled=PackedStringArray("res://addons/gameai/plugin.cfg")

[rendering]
renderer/rendering_method="gl_compatibility"
