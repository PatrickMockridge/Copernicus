// Marketplace — thin sale layer. robot -> asking price (a quoted name).
// v1: list/buy update an asking-price ledger; REV escrow via revVault is a v2 refinement.
// Public name: @"copernicus:marketplace"
// Messages:
//   ("list", @robot, @price)   write — record asking price
//   ("buy",  @robot, @buyer)   write — remove the listing (capability transfer handled by ownership)
new marketplace(@"copernicus:marketplace"), priceCh in {
  priceCh!({}) |

  contract marketplace(@"list", @robot, @price) = {
    for (map <- priceCh) {
      priceCh!(*map.set(robot, price))
    }
  } |

  contract marketplace(@"buy", @robot, @buyer) = {
    for (map <- priceCh) {
      priceCh!(*map.delete(robot))
    }
  }
}
