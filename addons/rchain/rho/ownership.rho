// Ownership — capability ledger. robot -> holder address (a quoted name).
// v1: holder tracked as a name; "revoked" is a sentinel holder value.
// Public name: @"copernicus:ownership"
// Messages:
//   ("issue",    @robot, @holder)   write — bind holder
//   ("transfer", @robot, @from, @to)  write — update holder (only if @from is the current holder)
//   ("holder",   @robot, ret)       read  — ret!(holder)
//   ("revoke",   @robot)            write — set holder = "revoked"
new ledgerCh in {
  ledgerCh!({}) |

  contract @"copernicus:ownership"(@"issue", @robot, @holder) = {
    for (ledger <- ledgerCh) {
      ledgerCh!(*ledger.set(robot, holder))
    }
  } |

  contract @"copernicus:ownership"(@"transfer", @robot, @from, @to) = {
    for (ledger <- ledgerCh) {
      if (*ledger.get(robot) != from) {
        ledgerCh!(*ledger)
      } else {
        ledgerCh!(*ledger.set(robot, to))
      }
    }
  } |

  contract @"copernicus:ownership"(@"holder", @robot, ret) = {
    for (ledger <<- ledgerCh) {
      ret!(*ledger.get(robot))
    }
  } |

  contract @"copernicus:ownership"(@"revoke", @robot) = {
    for (ledger <- ledgerCh) {
      ledgerCh!(*ledger.set(robot, "revoked"))
    }
  }
}
