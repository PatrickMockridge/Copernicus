// Jobs — task coordination. job_id -> state (a quoted name).
// v1: self-contained state machine; capability-gated claim (join on ownership) is a v2 refinement.
// Public name: @"copernicus:jobs"
// Messages:
//   ("publish",  @job_id, @spec)    write — state = "published"
//   ("claim",    @job_id, @robot)   write — state = "claimed" (only if published)
//   ("complete", @job_id, @result)  write — state = "completed"
//   ("cancel",   @job_id)           write — state = "cancelled"
new jobsCh in {
  jobsCh!({}) |

  contract @"copernicus:jobs"(@"publish", @job_id, @spec) = {
    for (map <- jobsCh) {
      jobsCh!(*map.set(job_id, "published"))
    }
  } |

  contract @"copernicus:jobs"(@"claim", @job_id, @robot) = {
    for (map <- jobsCh) {
      if (*map.get(job_id) == "published") {
        jobsCh!(*map.set(job_id, "claimed"))
      } else {
        jobsCh!(*map)
      }
    }
  } |

  contract @"copernicus:jobs"(@"complete", @job_id, @result) = {
    for (map <- jobsCh) {
      jobsCh!(*map.set(job_id, "completed"))
    }
  } |

  contract @"copernicus:jobs"(@"cancel", @job_id) = {
    for (map <- jobsCh) {
      jobsCh!(*map.set(job_id, "cancelled"))
    }
  }
}
