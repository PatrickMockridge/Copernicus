// Inbox — per-address message buffer. addr -> [messages...] (a list of quoted names).
// v1: single contract keyed by address; per-address names ("copernicus:inbox:<addr>") are a v2 refinement.
// Public name: @"copernicus:inbox"
// Messages:
//   ("write", @addr, @message)   write — append a message
//   ("read",  @addr, ret)        read  — ret!(messages) and clear
new inbox(@"copernicus:inbox"), inboxCh in {
  inboxCh!({}) |

  contract inbox(@"write", @addr, @message) = {
    for (map <- inboxCh) {
      inboxCh!(*map.set(addr, *map.get(addr) ++ [message]))
    }
  } |

  contract inbox(@"read", @addr, ret) = {
    for (map <- inboxCh) {
      ret!(*map.get(addr)) |
      inboxCh!(*map.set(addr, []))
    }
  }
}
