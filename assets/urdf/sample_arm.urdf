<?xml version="1.0"?>
<robot name="sample_arm">
  <!-- Simple 2-DOF planar arm (revolute about Z) for testing joint control. -->

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.55 1"/>
      </material>
    </visual>
  </link>

  <link name="link1">
    <visual>
      <geometry>
        <box size="0.09 0.26 0.09"/>
      </geometry>
      <material name="blue">
        <color rgba="0.25 0.5 0.9 1"/>
      </material>
    </visual>
  </link>

  <link name="link2">
    <visual>
      <geometry>
        <box size="0.07 0.22 0.07"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.3 0.3 1"/>
      </material>
    </visual>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0.13 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0.26 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6" upper="2.6" effort="10" velocity="1"/>
  </joint>
</robot>
