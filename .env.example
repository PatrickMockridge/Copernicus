# AI Provider API Keys
# Copy this to .env and fill in your keys
# Run Godot and the AI will connect automatically

# Minimax (recommended - same key as Claude Code in VS Code)
# Get your key from platform.minimax.io or use Claude Code's key
ANTHROPIC_API_KEY=your_minimax_api_key_here
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic

# OpenAI (optional)
# OPENAI_API_KEY=your_openai_api_key_here
