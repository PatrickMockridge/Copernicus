# Copernicus AI assistant — Anthropic-compatible API configuration.
# Copy this file to .env and set your key, then run the app:
#   cp .env.example .env
#   godot scenes/main.tscn
# The AI assistant (right-hand panel) reads these automatically on launch.

# Required: your API key for the Anthropic-compatible endpoint you use.
# Real Claude uses an Anthropic key (sk-ant-...). Anthropic-compatible
# providers (Deepseek, Minimax, ...) use their own key in this same field.
ANTHROPIC_API_KEY=your_api_key_here

# Optional: base URL of the Anthropic-compatible endpoint (the /v1/messages API).
# Defaults to https://api.anthropic.com (real Claude). Point it at any provider
# that exposes the Anthropic Messages API, e.g.:
#   ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
#ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: model name. Defaults to claude-sonnet-4-6. Set the model id your
# endpoint expects (e.g. a Deepseek or Minimax model id). The model must
# support Anthropic tool use (the assistant edits files via tools).
#ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: the directory the AI assistant codes in. Defaults to ~/robot_workspace.
# Point it at YOUR robot project — never the Copernicus source tree.
#AI_WORKSPACE=~/robot_workspace

# Optional legacy providers (not used by the default assistant):
#OPENAI_API_KEY=your_openai_api_key_here
#MINIMAX_API_KEY=your_minimax_api_key_here
